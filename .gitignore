__pycache__/
*.py[cod]
.venv/
.venv-ci/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
# Prepared assets are generated by scripts/prep_asset.py from a source model that is itself
# not in git; the per-asset mapping (configs/assets/) and the prim dump fixture are.
data/assets/

# Source models are third-party and large (the Phantom 4 FBX is 62 MB). The per-asset mapping
# in configs/assets/ names the file it was prepared from; the file itself is fetched, not tracked.
3d_models/

data/lut/*.npy
data/lut/*.json
data/lut/*.f32
outputs/

# The built site (`make site`). It is an artefact: the generator, the stylesheet and the
# gallery manifest under site/ are tracked, the 20 MB of re-encoded media it produces is not.
_site/
*.usdc
.DS_Store

# Validation datasets are not in git (ADR 0003, roadmap ME.1); the index is.
data/validation/*/
docs/validation/.*-clips.json

# pytest-cov leaves these behind; they are a measurement of one run, not a property of the repo.
.coverage
.coverage.*
htmlcov/
