__pycache__/
*.py[cod]
.venv/
.venv-ci/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
# Prepared assets are generated by scripts/prep_asset.py from a source model that is itself
# not in git; the per-asset mapping (configs/assets/) and the prim dump fixture are.
data/assets/

# Source models are third-party and large (the Phantom 4 FBX is 62 MB). The per-asset mapping
# in configs/assets/ names the file it was prepared from; the file itself is fetched, not tracked.
3d_models/

data/lut/*.npy
data/lut/*.json
data/lut/*.f32
outputs/
captures/

# The built site (`make site`). It is an artefact: the generator, the stylesheet and the
# gallery manifest under site/ are tracked, the 20 MB of re-encoded media it produces is not.
_site/
*.usdc
.DS_Store

# Validation datasets are not in git (ADR 0003, roadmap ME.1); the index is.
data/validation/*/
# Public aerial-target datasets (Anti-UAV RGBT, the Drone Detection Dataset, HIT-UAV), 6.8 GB,
# kept beside the tree for later evaluation of the sky-object renders; not tracked.
/datasets/
docs/validation/.*-clips.json

# pytest-cov leaves these behind; they are a measurement of one run, not a property of the repo.
.coverage
.coverage.*
htmlcov/
# The USGS Spectral Library v7 archive (ASCIIdata_splib07a.zip), unzipped here to feed
# scripts/import_paired_spectra.py. 113 MB of raw spectra: the importer commits only the curves
# it uses, under data/spectra/materials/usgs/.
ASCIIdata_splib07a/
# Papers and manuals the owner downloaded for reference (copyrighted PDFs, cited, never
# redistributed), and a stray download cache.
papers/
.cache_spectra/

# Thermal Model Zoo bundles (scripts/zoo_bundle.py): build output, published from the zoo repo
zoo_bundles/

# yolo runs
runs/

# Ultralytics weights it downloads into the working directory (yolo11n.pt and the like)
/yolo*.pt

# `make check`'s test selection (ADR 0193): testmon's coverage database and the record of which
# data files each test module reads. Per-machine state, rebuilt by `make check-full`.
.testmondata
.testmondata-shm
.testmondata-wal
.testreads.json
.testreads.tmp
.testreads-shards/
